#!/bin/sh

branch=$(git branch --show-current 2>/dev/null)
if [ "$branch" != "M.I.L.O" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
    exit 0
fi

if ! printf '%s\n' "$staged" | grep -qx 'direction.md'; then
    echo "M.I.L.O commit rejected: update and stage direction.md with what changed and why." >&2
    exit 1
fi

exit 0
